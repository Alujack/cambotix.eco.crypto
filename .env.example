# Run python3 scripts/setup.py to generate unique local secrets.
POSTGRES_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
ENGINE_TOKEN=GENERATE
N8N_PORT=5681
ENGINE_PORT=8020

# AI. anthropic = Claude via the official SDK; mock = deterministic offline stand-in (tests, smoke).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Stage 1 (information extraction) is high-volume and cheap; stage 2 (economic analyst) is the reasoning model.
EXTRACT_MODEL=claude-haiku-4-5
ANALYST_MODEL=claude-opus-5
ANALYST_EFFORT=high
AI_TIMEOUT_SECONDS=180

# Embeddings for pgvector (event clustering + historical context). openai | voyage | ollama | none.
# With openai and an empty key, embeddings are disabled and the engine falls back to lexical clustering.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=
VOYAGE_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Collectors. Alpha Vantage free tier is ~25 requests/day; the collector runs hourly (24/day). Leave empty to skip.
ALPHA_VANTAGE_API_KEY=
# Optional CoinGecko demo key (raises rate limits for the market-reaction tracker).
COINGECKO_API_KEY=
# Measure Gold/FX reactions through Alpha Vantage as well (consumes the same daily quota). Crypto is always measured.
REACTIONS_FX_ENABLED=false

# Pipeline tuning.
EXTRACT_BATCH=5
EXTRACT_MIN_PRIOR=15
ANALYZE_MIN_IMPORTANCE=40
ANALYZE_DEBOUNCE_SECONDS=180
REANALYZE_MIN_SECONDS=900
BRIEF_USE_AI=true

# Telegram delivery: daily brief at 06:00 UTC and alerts for analyzed events with importance >= the threshold.
# Create a bot with @BotFather, paste its token, then run python3 scripts/telegram_setup.py to discover the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_MIN_IMPORTANCE=80
