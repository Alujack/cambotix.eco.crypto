# Run python3 scripts/setup.py to generate unique local secrets.
POSTGRES_PASSWORD=GENERATE
N8N_ENCRYPTION_KEY=GENERATE
ENGINE_TOKEN=GENERATE
N8N_PORT=5681
ENGINE_PORT=8020

# AI provider: ollama = local Llama through Ollama (default); anthropic = Claude via the official SDK;
# mock = deterministic offline stand-in (tests, smoke).
AI_PROVIDER=ollama
# Stage 1 (information extraction) is high-volume; stage 2 (economic analyst) is the reasoning step. One model for both
# keeps it resident in memory. Other choices: llama3.2:3b (faster extraction), llama3.3:70b (needs ~48 GB).
EXTRACT_MODEL=llama3.1:8b
ANALYST_MODEL=llama3.1:8b
# OLLAMA_RUNTIME: native = project-local macOS Ollama on 127.0.0.1:11436 (setup.py picks this on macOS);
# docker = the ollama container (CPU only unless COMPOSE_FILE=compose.yaml:compose.gpu.yaml adds an NVIDIA GPU);
# external = an Ollama you run yourself (set OLLAMA_BASE_URL, e.g. http://host.docker.internal:11434).
OLLAMA_RUNTIME=docker
COMPOSE_PROFILES=docker-ai
OLLAMA_BASE_URL=http://ollama:11434
# Claude alternative: AI_PROVIDER=anthropic, EXTRACT_MODEL=claude-haiku-4-5, ANALYST_MODEL=claude-opus-5.
ANTHROPIC_API_KEY=
ANALYST_EFFORT=high
AI_TIMEOUT_SECONDS=300
# One context size for every Ollama call. Do not vary it per stage: Ollama keys its loaded model instance on num_ctx,
# so a different value between calls unloads and reloads the whole model (a 10 s call became a 5 min timeout on 16 GB).
OLLAMA_NUM_CTX=16384
# Split the analyst into an economic read plus one narrow call per affected asset. Unset = on for ollama (a single
# call filling the whole nested schema is where a small model hedges scores and contradicts itself), off for anthropic.
ANALYST_DECOMPOSE=

# Embeddings for pgvector (event clustering + historical context): ollama (default, nomic-embed-text) | openai |
# voyage | none. With openai/voyage and an empty key, embeddings are disabled and clustering falls back to lexical matching.
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Collectors. Alpha Vantage free tier is ~25 requests/day; the collector runs hourly (24/day). Leave empty to skip.
ALPHA_VANTAGE_API_KEY=
# Optional CoinGecko demo key (raises rate limits for the market-reaction tracker).
COINGECKO_API_KEY=
# Measure Gold/FX reactions through Alpha Vantage as well (consumes the same daily quota). Crypto is always measured.
REACTIONS_FX_ENABLED=false

# Pipeline tuning.
EXTRACT_BATCH=3   # local inference runs ~25s per article on an M1 Pro; keep a batch inside one tick
EXTRACT_MIN_PRIOR=15
ANALYZE_MIN_IMPORTANCE=40
ANALYZE_DEBOUNCE_SECONDS=180
REANALYZE_MIN_SECONDS=900
# Model-written narrative paragraph in the daily brief. Unset = on for anthropic/mock, OFF for ollama: an 8B model
# was observed inventing an event that was not in its input. The brief's data sections never depend on this.
BRIEF_USE_AI=

# Delivered language for Telegram messages and the rendered brief: en (default) | km (Khmer). Storage never moves:
# the database, the intelligence API and the groundedness gate stay English, so the trading engines are unaffected.
# Labels come from a static table; the engine's own prose (summaries, key risks, narrative, causal chain) is
# translated by TRANSLATE_MODEL and needs ANTHROPIC_API_KEY - without a key the labels are translated and the prose
# is delivered in English. Headlines and event titles are always delivered in the source's own words.
OUTPUT_LANGUAGE=en
TRANSLATE_MODEL=claude-haiku-4-5

# Telegram delivery: daily brief at 06:00 UTC and alerts for analyzed events with importance >= the threshold.
# Create a bot with @BotFather, paste its token, then run python3 scripts/telegram_setup.py to discover the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_MIN_IMPORTANCE=80

# Public posting. TELEGRAM_CHANNEL_ID (@name or -100... id, the bot must be an admin) turns the daily brief and
# high-impact events into channel posts as well - news for readers, not the operator's brief. Leave it empty and
# nothing is published; the text is still served by GET /social/daily and GET /social/event/{id} for a Facebook page
# or anywhere else. The channel bar sits above the private alert bar on purpose: a publication is more selective.
TELEGRAM_CHANNEL_ID=
SOCIAL_MIN_IMPORTANCE=85
