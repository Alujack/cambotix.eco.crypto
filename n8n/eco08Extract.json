{
  "id": "eco08Extract",
  "name": "Eco 08 \u2014 Extract facts + cluster events",
  "active": false,
  "nodes": [
    {
      "id": "every-30-seconds",
      "name": "Every 30 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "call-engine--process-extract",
      "name": "Call engine /process/extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://engine:8000/process/extract",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 240000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ecoEngineAuth",
          "name": "Eco engine internal API"
        }
      }
    }
  ],
  "connections": {
    "Every 30 seconds": {
      "main": [
        [
          {
            "node": "Call engine /process/extract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "pinData": {},
  "tags": []
}
