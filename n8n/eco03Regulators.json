{
  "id": "eco03Regulators",
  "name": "Eco 03 \u2014 Regulators (SEC / CFTC)",
  "active": false,
  "nodes": [
    {
      "id": "every-10-minutes",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "sec_press",
      "name": "sec_press",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        280,
        0
      ],
      "parameters": {
        "url": "https://www.sec.gov/news/pressreleases.rss",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "cftc_press",
      "name": "cftc_press",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        280,
        200
      ],
      "parameters": {
        "url": "https://www.cftc.gov/RSS/RSSGP/rssgp.xml",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "normalize-feed-items",
      "name": "Normalize feed items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        100
      ],
      "parameters": {
        "jsCode": "// One run per upstream feed node; $prevNode.name is the source key from sources/registry.json.\nconst source = $prevNode.name;\nconst strip = (s) => String(s || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\nconst items = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (!j.title || j.error) continue;\n  items.push({\n    headline: strip(j.title).slice(0, 500),\n    url: j.link || null,\n    externalId: j.guid || j.id || j.link || null,\n    publishedAt: j.isoDate || j.pubDate || j.published || null,\n    content: strip(j.contentSnippet || j.content || j.summary || j.description).slice(0, 4000),\n    publisher: j.creator || j.author || null,\n  });\n}\nif (!items.length) return [];\nreturn [{ json: { source, items } }];\n"
      }
    },
    {
      "id": "ingest-into-engine",
      "name": "Ingest into engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://engine:8000/ingest/articles",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ecoEngineAuth",
          "name": "Eco engine internal API"
        }
      }
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [
        [
          {
            "node": "sec_press",
            "type": "main",
            "index": 0
          },
          {
            "node": "cftc_press",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "sec_press": {
      "main": [
        [
          {
            "node": "Normalize feed items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "cftc_press": {
      "main": [
        [
          {
            "node": "Normalize feed items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize feed items": {
      "main": [
        [
          {
            "node": "Ingest into engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "pinData": {},
  "tags": []
}
